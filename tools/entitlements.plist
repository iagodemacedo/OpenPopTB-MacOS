<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- the game bundle is compiled on the player's Mac (runtime/prepare.c), so it is only ad-hoc
	     signed; the hardened runtime would refuse to dlopen it without this -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
